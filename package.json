{
  "name": "tdp-examples",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "format": "pnpm run format:ts",
    "format:ts": "biome format --write .",
    "format:ts:check": "biome format .",
    "lint": "pnpm run lint:ts",
    "lint:fix": "pnpm run lint:ts:fix",
    "lint:ts": "biome check --error-on-warnings .",
    "lint:ts:fix": "biome check --error-on-warnings --write .",
    "typecheck": "pnpm run check:ts",
    "check": "pnpm run check:ts",
    "check:ts": "pnpm -r run check",
    "verify": "pnpm run lint && pnpm run check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15"
  }
}
